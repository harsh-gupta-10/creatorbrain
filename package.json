{
  "name": "creatorbrain",
  "version": "1.0.0",
  "description": "CreatorBrain: an assistant that studies a creator's YouTube and Instagram content and drafts in their voice",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "E2E=1 vitest run",
    "check": "tsc --noEmit && vitest run && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply creatorbrain-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply creatorbrain-db --remote",
    "dev:worker": "wrangler dev"
  },
  "keywords": [
    "creator-economy",
    "assistant",
    "cloudflare-workers",
    "hono",
    "react",
    "d1",
    "workers-ai"
  ],
  "author": "Harsh Gupta",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.13.18",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
