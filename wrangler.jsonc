{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creatorbrain",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "creatorbrain-db",
      "database_id": "creatorbrain-local-db",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "creatorbrain-kv"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_FAST_MODEL": "claude-haiku-5-5",
    "OPENAI_MODEL": "gpt-4o-mini",
    "AMAZON_DEFAULT_MARKETPLACE": "amazon.in"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  }
}
