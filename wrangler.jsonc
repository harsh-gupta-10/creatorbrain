{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creatorbrain-app",
  "account_id": "b1d481965d10a5b83a86f3ba67c2e0ed",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*", "/@*", "/%40*"]
  },
  "ai": {
    "binding": "AI"
  },
  // 10 sign-in or sign-up attempts per IP per minute
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "creatorbrain-db",
      "database_id": "52e33f46-f0f0-47ac-b2d0-c56825ea330c",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "202e40b4c38c4492aee3e00904d092f3"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_FAST_MODEL": "claude-haiku-5-5",
    "OPENAI_MODEL": "gpt-4o-mini",
    "GEMINI_MODEL": "gemini-2.5-flash"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  }
}
