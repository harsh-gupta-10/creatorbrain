# Copy to .dev.vars for npm run dev:worker. Git ignores local secret files.
# Add production secrets in the Cloudflare Worker settings.

ENVIRONMENT=development

# Required: 32+ random characters. Encrypts each creator's Amazon credentials (AES-GCM).
# Generate one with: openssl rand -base64 48
ENCRYPTION_KEY=

# Optional. Without these the app uses free fallbacks:
# Workers AI for analysis, YouTube's public feed and caption tracks for uploads and transcripts.
GEMINI_API_KEY=      # Gemini watches each video and its thumbnail
YOUTUBE_API_KEY=     # lists up to 50 uploads with duration, tags and comment counts
ANTHROPIC_API_KEY=   # Claude for channel strategy and drafting
OPENAI_API_KEY=

# Amazon Associates credentials are NOT environment variables: each creator enters their
# own tracking ID and API keys in the app, and they are stored encrypted per creator in D1.

# Flagsmith Studio experiment (optional)
# FLAGSMITH_SDK_KEY=
# FLAGSMITH_IDENTITY_SECRET=
# FLAGSMITH_EXPERIMENT_ID=
# FLAGSMITH_OPERATOR_CREATOR_ID=
# FLAGSMITH_MANAGEMENT_KEY=
# FLAGSMITH_PROJECT_ID=
